# Copy to .env and fill in the values. Validated at startup by libs/config.ts.
NODE_ENV=development

# Postgres and Redis from the root docker-compose.yml
DATABASE_URL=postgresql://campusly:campusly@localhost:5432/campusly?schema=public
REDIS_URL=redis://localhost:6379

# Random secrets, at least 32 characters: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_URL=http://localhost:3001
PORT_API=3000
# Public demo: "Demo login" buttons sign in as the seeded demo accounts (also flags them in the seed)
DEMO_MODE=false

# Password for every account created by `pnpm prisma db seed` and the batch's nightly demo reset (local / demo data only, min 8 chars)
SEED_PASSWORD=
# The seed wipes every table; on a non-local DB it runs only with SEED_ALLOW_RESET=true (demo server, one-off flag)

# Media: S3 + CloudFront (DECISIONS §11). Leave all empty to run without uploads/videos.
AWS_REGION=eu-central-1
S3_BUCKET=
# Local only (IAM user limited to the bucket); production uses the EC2 IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# Private key that signs video links, kept OUTSIDE the repo (production: CLOUDFRONT_PRIVATE_KEY with the PEM text)
CLOUDFRONT_PRIVATE_KEY_PATH=

# Production only (EC2, docker-compose.prod.yml reads .env.production, built from SSM).
# The host Caddy serves and gets the HTTPS certificate for; "http://localhost" = plain HTTP for a local test.
API_DOMAIN=
