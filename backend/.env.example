# Copy to .env and fill in the values. Validated at startup by libs/config.ts.
NODE_ENV=development

# Postgres and Redis from the root docker-compose.yml
DATABASE_URL=postgresql://campusly:campusly@localhost:5432/campusly?schema=public
REDIS_URL=redis://localhost:6379

# Random secrets, at least 32 characters: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_URL=http://localhost:3001
PORT_API=3000

# Password for every account created by `pnpm prisma db seed` (local / demo data only, min 8 chars)
SEED_PASSWORD=
