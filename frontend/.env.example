# Copy to .env.local. NEXT_PUBLIC_* values are visible in the browser: never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3000
# The site's own address, for link previews (og:image); defaults to https://campusly.uz
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# true only on the public demo (with DEMO_MODE=true on the API): shows the "Demo login" buttons
NEXT_PUBLIC_DEMO_MODE=false
